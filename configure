#!/bin/sh

# Locate a Python interpreter and re-execute the script using Python 3
# We avoid hardcoding python2 since we want to support modern systems
_=[ 'exec' '/bin/sh' '-c' '''
which python3 >/dev/null && exec python3 "$0" "$@"
which python >/dev/null && exec python "$0" "$@"
echo "No compatible python found (need python3)" >&2
exit 1
''' "$0" "$@"
]
del _

import sys
from distutils.spawn import find_executable as which

# Optional version check (Python >= 3.6 recommended)
if sys.version_info < (3, 6):
    sys.stderr.write("Python 3.6 or higher is required.\n")
    sys.exit(1)

