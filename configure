#!/bin/sh
_=[ 'exec' '/bin/sh' '-c' '''
which python3 >/dev/null && exec python3 "$0" "$@"
which python >/dev/null && exec python "$0" "$@"
echo "No compatible python found (need python3)" >&2
exit 1
''' "$0" "$@"
]
del _

import sys
import subprocess
import os

if sys.version_info < (3, 6):
    sys.stderr.write("Python 3.6 or higher is required.\n")
    sys.exit(1)

print("Running configure with Python", sys.version)

# Run the original gyp-based configuration step
try:
    subprocess.check_call([
        'python3',
        'tools/gyp_node.py',
        '-f', 'make',
        '--dest-cpu=arm64',
        '--dest-os=ios',
        '--with-intl=none',
        '--cross-compiling',
        '--enable-static',
        '--openssl-no-asm',
        '--v8-options=--jitless',
        '--without-node-code-cache',
        '--without-node-snapshot'
    ])
except subprocess.CalledProcessError as e:
    print(f"configure failed: {e}")
    sys.exit(1)

# Success
print("✔️  configure complete — config.gypi generated")
